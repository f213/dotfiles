{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf": {
          "name": "qwen3-coder"
        }
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ruff": {
      "extensions": [".py"],
      "command": ["pipx", "run", "-q", "ruff", "server"]
    },
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-4-5",
      "tools": {
        "bash": true
      }
    }
  }
}
